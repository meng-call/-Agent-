# ============================================
# LLM Provider (必需)
# ============================================
LLM_PROVIDER=deepseek
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ============================================
# Embedding Model (必需)
# ============================================
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu

# ============================================
# Milvus Vector Database (必需)
# ============================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DB_NAME=contract_review
MILVUS_COLLECTION_NAME=legal_knowledge

# ============================================
# MySQL Relational Database (可选 — 审查历史持久化)
# 不配置此项不影响审查功能，仅跳过 DB 写入
# ============================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=contract_review
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=contract_review

# ============================================
# Deployment
# ============================================
ENV=development
LOG_LEVEL=INFO
